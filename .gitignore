# ── Dependencies ──────────────────────────────────────────────────────────
node_modules
node_modules/.tmp

# ── Build output ──────────────────────────────────────────────────────────
dist
dist-ssr
coverage
*.tsbuildinfo

# ── Vite ──────────────────────────────────────────────────────────────────
.vite
*.local

# ── Tauri / Rust ──────────────────────────────────────────────────────────
# `target` is ~10 GB of build cache; `gen` is regenerated by tauri-build on
# every build, so neither belongs in history.
src-tauri/target
src-tauri/gen
**/*.rs.bk

# Generated desktop bundles — rebuilt by `npm run desktop:build`.
*.dmg
*.app.zip

# ── Secrets ───────────────────────────────────────────────────────────────
# Vaultwork keeps credentials in the OS keychain and never in the repo. These
# patterns exist so a stray file cannot be committed by accident, not because
# the application reads any of them.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.mobileprovision
secrets.json
credentials.json

# ── Personal data ─────────────────────────────────────────────────────────
# Vault contents, exports and backups are the user's own files. Nothing in the
# application writes them here, but an export dropped in the repo must not be
# committed.
*.pdf
vault/
vaultwork-backup*.json

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ── Editors ───────────────────────────────────────────────────────────────
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
